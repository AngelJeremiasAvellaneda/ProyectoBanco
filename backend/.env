# ── Supabase / PostgreSQL ──────────────────────────────────────
# Puerto 6543 = Session mode pooler (requerido para JDBC con username que contiene punto)
# Puerto 5432 = Transaction mode (NO compatible con JDBC directo)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.utdlprovegxdjjgsykxl
SUPABASE_DB_PASSWORD=angelja1234t$

# ── JWT ────────────────────────────────────────────────────────
# Genera un secreto seguro: openssl rand -base64 64
JWT_SECRET=MiClaveSecretaSuperSeguraParaBancoConfianza2026XYZ
JWT_EXPIRATION_MS=86400000

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
